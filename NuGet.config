<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources are deliberately cleared.

  This repository has ZERO NuGet dependencies, which means:
    * it restores and builds with no network at all,
    * it works on a locked-down enterprise build agent,
    * and it works on conference wifi, which is the same thing.

  That constraint also makes the demo honest. Most of the legacy systems this
  talk is about live behind a feed you cannot reach from a laptop on stage.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
